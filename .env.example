# Copy to .env on the server (never commit .env). Values here are placeholders, not secrets.
POSTGRES_PASSWORD=change-me-long-random
GIZER_PUBLIC_ORIGIN=https://nba.gizergroup.com
GIZER_OWNER_EMAIL=owner@example.com
GIZER_OWNER_PASSWORD=change-me-at-least-12-chars
GIZER_COOKIE_SECURE=true
GIZER_SEASONS=2025-26,2026-27
GIZER_WEB_PORT=3410
# Optional. Without it player-prop quotes are reported as unavailable (never invented).
GIZER_ODDS_API_KEY=
GIZER_ODDS_API_MONTHLY_QUOTA=500
GIZER_ODDS_API_MONTHLY_COST_USD=0
GIZER_PAPER_UNIT=1.0
BACKUP_KEEP_DAYS=14

# JARVIS (AI assistant). Leave the key empty to keep it off; everything else works without it.
# Create a dedicated key in an isolated Anthropic workspace for this project. Never commit the real value.
ANTHROPIC_API_KEY=
GIZER_JARVIS_ENABLED=true
# Owner-authorised cumulative (lifetime, not monthly) budget in USD, the line where ordinary requests stop, and the
# daily ceiling. The application enforces these; they can be lowered in /admin/ai-budget but never raised above the cap.
GIZER_JARVIS_LIFETIME_CAP_USD=100
GIZER_JARVIS_SUSPEND_AT_USD=95
GIZER_JARVIS_DAILY_CAP_USD=2

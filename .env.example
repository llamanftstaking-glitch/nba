# Copy to .env on the server (never commit .env). Values here are placeholders, not secrets.
POSTGRES_PASSWORD=change-me-long-random
GIZER_PUBLIC_ORIGIN=https://nba.gizergroup.com
GIZER_OWNER_EMAIL=owner@example.com
GIZER_OWNER_PASSWORD=change-me-at-least-12-chars
GIZER_COOKIE_SECURE=true
GIZER_SEASONS=2025-26,2026-27
GIZER_WEB_PORT=3410
# Optional. Without it player-prop quotes are reported as unavailable (never invented).
GIZER_ODDS_API_KEY=
GIZER_ODDS_API_MONTHLY_QUOTA=500
GIZER_ODDS_API_MONTHLY_COST_USD=0
GIZER_PAPER_UNIT=1.0
BACKUP_KEEP_DAYS=14
